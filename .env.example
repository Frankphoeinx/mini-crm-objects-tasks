# Только эти переменные попадают на клиент. Секретного ключа Supabase здесь быть не должно.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Общий пароль трёх демо-пользователей. Пусто: блока демо-входа нет.
# Осознанное решение владельца: значение попадает в собранный код сайта, это тестовая платформа.
VITE_DEMO_PASSWORD=

# Только для scripts/seed-users.mjs, на сайт не попадают. Значения задавайте в окружении команды, в файл не записывайте.
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# DEMO_PASSWORD=
