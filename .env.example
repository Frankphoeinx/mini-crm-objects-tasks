# Только эти переменные попадают на клиент. Секретного ключа Supabase здесь быть не должно.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Общий пароль трёх демо-пользователей. Пусто: блока демо-входа нет.
